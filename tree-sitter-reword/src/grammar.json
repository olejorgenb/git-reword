{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "reword",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "SYMBOL",
                "name": "blank_line"
              },
              {
                "type": "SYMBOL",
                "name": "invalid_line"
              }
            ]
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "commit"
          }
        }
      ]
    },
    "commit": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "commit_line"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "SYMBOL",
                "name": "info_line"
              },
              {
                "type": "SYMBOL",
                "name": "blank_line"
              },
              {
                "type": "SYMBOL",
                "name": "invalid_line"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "message"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "commit_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "commit"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t]+"
        },
        {
          "type": "FIELD",
          "name": "sha",
          "content": {
            "type": "SYMBOL",
            "name": "sha"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[ \\t]+"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "sha": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[0-9a-f]{8}"
          },
          "named": true,
          "value": "short_sha"
        },
        {
          "type": "PATTERN",
          "value": "[0-9a-f]{32}([0-9a-f]{24})?"
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*\\n"
    },
    "info_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "info_key"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "info_value"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "info_key": {
      "type": "PATTERN",
      "value": "[A-Za-z][A-Za-z-]*:"
    },
    "info_value": {
      "type": "PATTERN",
      "value": "[^\\n]*"
    },
    "blank_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[ \\t]*\\n"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_indent"
            },
            {
              "type": "PATTERN",
              "value": "[ \\t]*\\n"
            }
          ]
        }
      ]
    },
    "message": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "subject"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_noise"
              },
              {
                "type": "SYMBOL",
                "name": "paragraph"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "trailers"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_noise"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_noise": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "blank_line"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "invalid_line"
        }
      ]
    },
    "paragraph": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "message_line"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "message_line"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                },
                {
                  "type": "SYMBOL",
                  "name": "invalid_line"
                }
              ]
            }
          }
        ]
      }
    },
    "trailers": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "PREC_RIGHT",
        "value": 0,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "trailer_line"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "trailer_line"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "comment"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "invalid_line"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "subject": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_indent"
        },
        {
          "type": "SYMBOL",
          "name": "subject_text"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "overflow",
              "content": {
                "type": "SYMBOL",
                "name": "overflow"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "subject_text": {
      "type": "PATTERN",
      "value": "[^\\n]{1,72}"
    },
    "overflow": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    },
    "message_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_indent"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "text"
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "trailer_key"
                },
                {
                  "type": "SYMBOL",
                  "name": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "trailer_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_indent"
        },
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "trailer_key"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "text"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    },
    "trailer_key": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[A-Za-z][A-Za-z0-9-]*:[ \\t]"
        }
      }
    },
    "_indent": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "    |\\t"
        }
      }
    },
    "invalid_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+\\n"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [
    [
      "message_line",
      "trailer_line"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}